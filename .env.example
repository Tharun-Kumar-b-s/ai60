# Postgres (Neon via Vercel Storage sets DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Salt for hashing IPs (any long random string)
IP_HASH_SALT=change-me-to-a-long-random-string
# Max registrations per IP per hour (raise for live demos on shared WiFi)
MAX_REGS_PER_IP_PER_HOUR=10
# Admin dashboard password (used in Phase 8)
ADMIN_PASSWORD=change-me
# LLM key for the evaluator (used in Phase 7)
ANTHROPIC_API_KEY=
